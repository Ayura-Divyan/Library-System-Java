<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.librarysystemjava.ImportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Data Import &amp; Error Correction">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
      <HBox spacing="15.0">
         <children>
      
              <Button mnemonicParsing="false" onAction="#onLoadClicked" text="Load CSV Files" />
            <Button mnemonicParsing="false" onAction="#onSaveClicked" text="Save Data" />
         </children>
      </HBox>

        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Books Data">
               <content>
                  <TableView prefHeight="200.0" prefWidth="200.0">
                    <columns>
                      <TableColumn prefWidth="75.0" text="C1" />
                      <TableColumn prefWidth="75.0" text="C2" />
                    </columns>
                  </TableView>
               </content>
               <content>
                  <TableView prefHeight="200.0" prefWidth="200.0">
                    <columns>
                      <TableColumn prefWidth="75.0" text="C1" />
                      <TableColumn prefWidth="75.0" text="C2" />
                    </columns>
                  </TableView>
               </content>
               <content>
                  <TableView fx:id="booksTable" prefHeight="200.0" prefWidth="200.0">
                    <columns>
                      <TableColumn fx:id="colBkId" text="Book ID" />
                      <TableColumn fx:id="colBkIsbn" prefWidth="130.0" text="ISBN" />
                        <TableColumn fx:id="colBkTitle" prefWidth="250.0" text="Title" />
                        <TableColumn fx:id="colBkCopies" text="Copies" />
                        <TableColumn fx:id="colBkAvail" text="Availability" />
                        <TableColumn fx:id="colBkPrice" text="Price" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
                </Tab>
                <Tab text="Students Data">
               <content>
                  <TableView prefHeight="200.0" prefWidth="200.0">
                    <columns>
                      <TableColumn prefWidth="75.0" text="C1" />
                      <TableColumn prefWidth="75.0" text="C2" />
                    </columns>
                  </TableView>
               </content>
               <content>
                  <TableView fx:id="studentsTable" prefHeight="200.0" prefWidth="200.0">
                    <columns>
                      <TableColumn fx:id="colStuId" prefWidth="75.0" text="Student ID" />
                      <TableColumn fx:id="colStuName" prefWidth="75.0" text="Name" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
                </Tab>
                <Tab text="Transactions Data">
               <content>
                  <TableView fx:id="transactionsTable" prefHeight="200.0" prefWidth="200.0">
                    <columns>
                      <TableColumn fx:id="colTrId" prefWidth="100.0" text="Trans ID" />
                      <TableColumn fx:id="colTrDate" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="colTrBkId" prefWidth="100.0" text="Book ID" />
                        <TableColumn fx:id="colTrStuId" prefWidth="120.0" text="Student ID" />
                        <TableColumn fx:id="colTrType" prefWidth="100.0" text="Type" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
                </Tab>
            </tabs>
        </TabPane>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <TextField fx:id="editField" promptText="Select a highlighted red record to edit..." HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onUpdateClicked" text="Update Record" />
            </children>
        </HBox>
    </children>
</VBox>
